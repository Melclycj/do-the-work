{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchsystem/schema/document-assurance-v3/document-work-spec.schema.json",
  "title": "DocumentWorkSpec — authored intent (sole owner: the run's executor, its WorkSpec author)",
  "description": "Maximum authored surface per plan §5.1. Contains only decisions the author must make. Generated digests, state, evidence and verdicts are forbidden by additionalProperties:false (V3-D5: the executor cannot author check outcomes; the spec never carries generated authority). The instruction-unit → obligation spine is V3-D7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "objective",
    "instruction_ref",
    "instruction_units",
    "change_boundary",
    "expected_artifacts",
    "obligations"
  ],
  "properties": {
    "work_id": { "$ref": "common.schema.json#/$defs/slug" },
    "objective": { "type": "string", "minLength": 8, "maxLength": 500 },
    "instruction_ref": {
      "$ref": "common.schema.json#/$defs/frozenFileRef",
      "description": "The exact frozen raw instruction (plan §6 step 1)."
    },
    "instruction_units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instructionUnit" },
      "description": "Stable, locatable units of the raw instruction. Every normative unit maps to at least one obligation; context requires a rationale (V3-D7, N1-A3)."
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/frozenFileRef" },
      "description": "Exact ground-truth/source refs + revisions. Absent when the instruction itself is the only input — never an empty placeholder."
    },
    "document_assurance_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profileSelection" },
      "description": "Exact leaf DocumentAssuranceProfile refs. Whole field absent when none (V3-D2: absence means no profile, never an empty placeholder; N1-A1)."
    },
    "change_boundary": { "$ref": "common.schema.json#/$defs/changeBoundary" },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expectedArtifact" }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/obligation" }
    }
  },
  "$defs": {
    "instructionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "locator", "classification"],
      "properties": {
        "unit_id": { "$ref": "common.schema.json#/$defs/slug" },
        "locator": { "$ref": "common.schema.json#/$defs/locator" },
        "classification": { "enum": ["obligation", "context"] },
        "obligation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/slug" }
        },
        "rationale": { "type": "string", "minLength": 8, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "obligation" } } },
          "then": {
            "required": ["obligation_ids"],
            "not": { "required": ["rationale"] }
          }
        },
        {
          "if": { "properties": { "classification": { "const": "context" } } },
          "then": {
            "required": ["rationale"],
            "not": { "required": ["obligation_ids"] }
          }
        }
      ],
      "description": "One locatable instruction unit. 'obligation' binds obligation_ids; 'context' requires an explicit non-normative rationale (V3-D7)."
    },
    "profileSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version"],
      "properties": {
        "profile_id": { "$ref": "common.schema.json#/$defs/slug" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "digest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "common.schema.json#/$defs/paramName" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "number" },
              { "type": "boolean" },
              {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            ]
          },
          "description": "Concrete values for the profile's declared parameters — task-local data belongs to the WorkSpec, never the profile (V3-D2)."
        }
      },
      "description": "Exact leaf profile pin. A non-authoritative bundle may expand to leaf refs before authoring but cannot override them (V3-D2)."
    },
    "expectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path"],
      "properties": {
        "artifact_id": { "$ref": "common.schema.json#/$defs/slug" },
        "path": { "$ref": "common.schema.json#/$defs/relPath" }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "instruction_unit_ids", "requirement", "verification_mode"],
      "properties": {
        "obligation_id": { "$ref": "common.schema.json#/$defs/slug" },
        "instruction_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/slug" }
        },
        "requirement": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "expected_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/slug" }
        },
        "verification_mode": { "$ref": "common.schema.json#/$defs/verificationMode" },
        "local_check_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/slug" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verification_mode": { "enum": ["local_check", "local_check_and_review"] } }
          },
          "then": { "required": ["local_check_refs"] }
        },
        {
          "if": {
            "properties": { "verification_mode": { "const": "review_only" } }
          },
          "then": { "not": { "required": ["local_check_refs"] } }
        }
      ],
      "description": "One requirement traced back to instruction units. Deterministic modes bind exact local checks (invariant 8); every obligation later receives exactly one fulfillment claim and one review disposition (invariant 2)."
    }
  }
}
