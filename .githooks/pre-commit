#!/bin/sh
# Instrument-side pre-commit: the instruction layer's path check and the ledger cap check.
#
# TRACKED hook, so it travels with a clone and lands inside review subjects. One per-machine
# step is still needed after a clone, because a hook path is config and config is not tracked:
#
#     git config core.hooksPath .githooks
#
# Until that command is run in a checkout, this file exists and nothing calls it. That is the
# whole of the wiring, and it is stated here, in README.md's "State of this repository" table,
# and in document-harness/ONBOARDING.md for a caller doing the same on its side.
#
# What it runs: layer_path_check.py, which blocks a repository path newly written into one of
# the instruction layer's seven members when that path does not resolve from this repository's
# root. Those seven members live here, so this is the repository where the check can resolve
# them; it was unwired from the caller on 2026-08-17, when the caller's duplicate copy of the
# instrument was deleted and 0 of the 9 it then had resolved there.
#
# What it does NOT run, and why: `review_freeze_check.py` and `candidate_path_check.py` guard
# a caller's staged work products and a caller's review window. Whether this repository — which
# is a caller of itself for its own construction rounds — should also run them was not part of
# the round that wired this file, and adding a guard nobody asked for is what E6 refuses.
#
# Advisory: bypassable with `git commit --no-verify`, and never a harness guarantee. The
# instruction layer's own instrument is the independent read (document-harness/README.md,
# "Local enforcement" row).

CHK=tooling/hooks/layer_path_check.py
# Joined 2026-08-28 (user ruling): the ledger's own bounds, which discipline alone did not
# hold — three breaches in one session, each found only by measuring by hand. It is not a
# second checker for this file; the count was zero (see the script's own docstring).
LEDGER_CHK=tooling/ledger_cap_check.py

# python3 first, python second, and each candidate must actually RUN, not merely exist:
# POSIX systems ship `python3` and often no `python` at all — measured 2026-08-23 on a wired
# Ubuntu clone, where the bare `python` this hook used to call failed every commit (exit 127)
# with the check never running. Windows Git Bash is the opposite (`python`, usually no
# `python3`), hence a fallback rather than a rename; and a name on PATH can be a Microsoft
# Store alias stub that resolves but does not run — the same measurement met one through WSL
# interop — hence the `-c pass` probe rather than `command -v` alone.
PY=""
for CAND in python3 python; do
  if command -v "$CAND" >/dev/null 2>&1 && "$CAND" -c "pass" >/dev/null 2>&1; then
    PY="$CAND"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no working python3 or python on PATH — the layer path check did NOT run."
  exit 1
fi

# Loud, not silent, on a missing script. An existence guard that skips quietly is how the
# caller's hook spent a month calling a script that had been deleted (split-design.md section 2).
for SCRIPT in "$CHK" "$LEDGER_CHK"; do
  if [ -f "$SCRIPT" ]; then
    "$PY" "$SCRIPT"
    status=$?
    if [ "$status" -ne 0 ]; then
      exit "$status"
    fi
  else
    echo "pre-commit: $SCRIPT not found — that check did NOT run."
    exit 1
  fi
done

exit 0
